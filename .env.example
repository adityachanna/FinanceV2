# AlphaSharp settings. Copy this file to .env (the launcher does it for you).
# Everything works without a key: questions are answered by the built-in data analyst.

# Optional: paste an OpenRouter key to turn on AI explanations (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=AlphaSharp

# Optional: Tavily key lets the AI assistant search the web
TAVILY_API_KEY=

# hsmm3 is the evaluated model. legacy loads the original saved artifact.
REGIME_MODEL_VERSION=hsmm3
